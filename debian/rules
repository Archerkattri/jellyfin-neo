#! /usr/bin/make -f

QTROOT ?= /opt/qt/6.11.3/gcc_64

# Headless builders have no display; run the ctest GUI cases offscreen
# (same as CI's test job) with Mesa software GL.
export QT_QPA_PLATFORM = offscreen

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCHECK_FOR_UPDATES=ON \
		-DBUNDLE_QT_RUNTIME=ON \
		-DUSE_STATIC_MPVQT=ON \
		-DQTROOT=$(QTROOT) \
		-DCMAKE_PREFIX_PATH=$(QTROOT) \
		-DQt6_DIR=$(QTROOT)/lib/cmake/Qt6

override_dh_shlibdeps:
	dh_shlibdeps -- --ignore-missing-info
