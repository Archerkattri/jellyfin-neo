      {
        "value": "always_force_transcode",
        "display_name": "Always Force Transcode",
        "default": false
      },
      {
        "value": "hdr_passthrough",
        "display_name": "HDR Passthrough (Experimental)",
        "help": "Experimental: ask mpv to signal HDR to the display (target-colorspace-hint) instead of tone-mapping to SDR. The default is false.\n\nCurrently has no visible effect: the embedded libmpv/OpenGL pipeline composites in SDR, so real HDR passthrough needs a native gpu-next window pipeline first. Safe to toggle; applies on the next video configuration update.",
        "default": false
      },
      {
        "value": "max_streaming_bitrate",
        "display_name": "Maximum Streaming Bitrate",
        "help": "Caps the video bitrate the server may send when transcoding. \"Auto\" leaves the choice to the server. Applies on next playback.",
        "default": 0,
        "possible_values": [
          [ 0, "Auto (no cap)" ],
          [ 80000000, "80 Mbps" ],
          [ 40000000, "40 Mbps" ],
          [ 20000000, "20 Mbps" ],
          [ 10000000, "10 Mbps" ],
          [ 4000000, "4 Mbps" ]
        ]
      },
      {
        "value": "external_player",
        "display_name": "Use External Player",
        "help": "Open video streams in the system's default media player instead of the built-in MPV player. Applies on next playback.",
        "default": false
      },
      {
        "value": "hdr_preference",
        "display_name": "HDR Format Preference",
        "help": "Prefer Dolby Vision or HDR10 when the server can send either. \"Auto\" keeps the Force Transcode Dolby Vision / HDR behavior.",
        "default": "auto",
        "possible_values": [
          [ "auto", "Auto" ],
          [ "dovi", "Prefer Dolby Vision" ],
          [ "hdr10", "Prefer HDR10" ]
        ]
      },
      {
        "value": "sync_mode",
        "display_name": "AV Sync Mode",
        "help": "How the player synchronizes audio and video.\n\nIf you use this option, you usually want to set it to display-resample to enable a timing mode that tries to not skip or repeat frames when for example playing 24fps video on a 24Hz screen.\n\n- Audio: time video frames to audio. This is the most robust mode, because the player doesn't have to assume anything about how the display behaves. The disadvantage is that it can lead to occasional frame drops or repeats. If audio is disabled, this uses the system clock.\n\n- Resample: resample audio to match the video. This mode will also try to adjust audio speed to compensate for other drift. (This means it will play the audio at a different speed every once in a while to reduce the A/V difference.)\n\n- Audio Drop: drop or repeat audio data to compensate desyncing video. This mode will cause severe audio artifacts if the real monitor refresh rate is too different from the reported or forced rate. Since mpv 0.33.0, this acts on entire audio frames, instead of single samples.",
        "default": "display-resample",
        "possible_values": [
          [ "audio", "Audio" ],
          [ "display-resample", "Resample" ],
          [ "display-adrop", "Audio Drop" ]
        ]
      },
