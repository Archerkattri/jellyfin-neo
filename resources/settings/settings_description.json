    "values": [
      {
        "value": "ass_scale_border_and_shadow",
        "display_name": "ASS Scale Border and Shadow",
        "help": "For ASS format subtitles, ensures that the text borders and shadows scale proportionally with the resolution.",
        "default": true
      },
      {
        "value": "ass_style_override",
        "display_name": "ASS Style Override",
        "help": "Control whether user style overrides should be applied. Note that all of these overrides try to be somewhat smart about figuring out whether or not a subtitle is considered a \"sign\".\n\nNo:\tRender subtitles as specified by the subtitle scripts, without overrides.\nYes:\tApply all the --sub-ass-* style override options. Changing the default for any of these options can lead to incorrect subtitle rendering (default).\nForce:\tLike yes, but also force all --sub-* options. Can break rendering easily.\nScale:\tLike yes, but also apply --sub-scale.\nStrip:\tRadically strip all ASS tags and styles from the subtitle. This is equivalent to the old --no-ass / --no-sub-ass options.\n\nThis also controls some bitmap subtitle overrides, as well as HTML tags in formats like SRT, despite the name of the option.",
        "default": "",
        "possible_values": [
